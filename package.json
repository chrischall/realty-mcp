{
  "name": "realty-mcp",
  "version": "0.6.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/realty-core && tsc -p packages/realty-core/tsconfig.check.json",
    "release:core": "npm publish --workspace=@chrischall/realty-core"
  },
  "devDependencies": {
    "@chrischall/mcp-utils": "^3.1.0",
    "@fetchproxy/server": "^3.6.2",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  }
}

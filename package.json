{
  "name": "realty-mcp",
  "version": "0.5.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/realty-core",
    "release:core": "npm publish --workspace=@chrischall/realty-core"
  },
  "devDependencies": {
    "@chrischall/mcp-utils": "^2.11.0",
    "@fetchproxy/server": "^3.5.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  }
}
